# ==========================================
# LingoFlow AI - Environment Configuration
# ==========================================

# Database Connection (SQLite by default for zero-config local run; use PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Authentication Security Secret (Must be 32+ characters in production)
JWT_SECRET="super-secret-jwt-key-for-lingoflow-change-this-in-production-32-chars"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Translation Provider Selection: "mymemory" (Default Free) | "google" | "mock"
TRANSLATION_PROVIDER="mymemory"

# Optional: Google Cloud Translation API (if TRANSLATION_PROVIDER="google")
GOOGLE_TRANSLATE_API_KEY=""

# Optional: Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional: Stripe Gateway (Test Mode)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
