// Prisma schema for LingoFlow AI

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  passwordHash String
  role         String        @default("USER") // "USER" | "ADMIN"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  translations  Translation[]
  usageRecords  UsageRecord[]
  subscriptions Subscription[]
}

model Plan {
  id                     String         @id @default(cuid())
  name                   String
  slug                   String         @unique // "free", "pro"
  price                  Int            @default(0) // In cents or smallest currency unit
  currency               String         @default("USD")
  monthlyCharLimit       Int            @default(5000)
  allowBusinessAssistant Boolean        @default(false)
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  planId                 String
  provider               String    @default("MANUAL") // "RAZORPAY" | "STRIPE" | "MANUAL"
  providerSubscriptionId String?   @unique
  status                 String    @default("ACTIVE") // "ACTIVE" | "CANCELLED" | "EXPIRED"
  currentPeriodEnd       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
}

model Translation {
  id             String   @id @default(cuid())
  userId         String?
  sourceLang     String
  targetLang     String
  sourceText     String
  translatedText String
  provider       String
  charCount      Int      @default(0)
  isFavorite     Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model UsageRecord {
  id            String   @id @default(cuid())
  userId        String
  operationType String   @default("TRANSLATE") // "TRANSLATE" | "BUSINESS_ASSISTANT"
  unitsUsed     Int      @default(0)
  billingMonth  String   // format "YYYY-MM"
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, billingMonth])
}

model PaymentEvent {
  id        String   @id @default(cuid())
  provider  String   // "RAZORPAY" | "STRIPE"
  eventId   String   @unique
  eventType String
  status    String   @default("PROCESSED")
  payload   String?
  createdAt DateTime @default(now())
}
